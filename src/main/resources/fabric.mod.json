{
    "schemaVersion": 1,
    "id": "crownmod",
    "version": "${version}",
    "name": "CrownMod",
    "description": "A Minecraft crown mod. If you wear the crown, villagers will follow you.",
    "authors": [
        "Carlos Escandón"
    ],
    "contact": {
        "sources": "https://github.com/Carlos-Escandon-O/CrownMod",
        "issues": "https://github.com/Carlos-Escandon-O/CrownMod/issues"
    },
    "license": "CC0-1.0",
    "icon": "assets/crownmod/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.carlosescandon.crownmod.CrownMod"
        ],
        "client": [
            "com.carlosescandon.crownmod.client.CrownModClient"
        ]
    },
    "mixins": [
        "crownmod.mixins.json",
        {
            "config": "crownmod.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.20.1",
        "minecraft": "~26.3",
        "java": ">=25",
        "fabric-api": "*"
    }
}
